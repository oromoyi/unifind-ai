# Copy to .env and edit. Never commit .env.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=8

# MySQL (either DATABASE_URL or the DB_* variables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=unifind
DB_PASSWORD=change-me
DB_NAME=unifind
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/unifind?charset=utf8mb4

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
STORAGE_BACKEND=local   # local | s3
# S3_BUCKET=  S3_REGION=  S3_PUBLIC_BASE_URL=  (+ standard AWS_* credentials)

# Optional email (SMTP). If SMTP_HOST is empty only in-app notifications are used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@unifind.test

RATELIMIT_ENABLED=true
